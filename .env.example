# Copy this file to `.env` and fill in the values for your own deployment.
# `.env` is gitignored and must never be committed.
#
# These values come from your Bicep deployment outputs (see README.md "Deploy the infrastructure"),
# except MCP_API_KEY/MCP_SERVER_URL which depend on which MCP tool server you wire up.

# Key Vault endpoint from the deployment output KEY_VAULT_ENDPOINT, e.g. https://kv-<workload>-<env>-<suffix>.vault.azure.net/
KEY_VAULT_URL=

# Display name and role used to personalize agent responses and partition long-term memory in Cosmos DB
USER_NAME=
USER_ROLE=Customer

# Azure region the resources were deployed to, e.g. eastus2
REGION=

# MCP (Model Context Protocol) tool server the ProductAgent calls for external product lookups
MCP_SERVER_URL=
MCP_API_KEY=
